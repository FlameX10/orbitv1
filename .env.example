# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voiceagent_db?schema=public"

# Application Config
PORT=5000
NODE_ENV=development
MAX_CONCURRENT_CALLS=10
DEFAULT_TIMEZONE=Asia/Kolkata
JWT_SECRET=your_jwt_secret_key_here

# Plivo Regional Configuration - India (+91)
# Create account in Plivo Console with Data Region: India
PLIVO_IN_AUTH_ID=your_india_plivo_auth_id
PLIVO_IN_AUTH_TOKEN=your_india_plivo_auth_token
PLIVO_IN_CALLER_NUMBER=+918065522583
PLIVO_IN_AGENT_TRIGGER_URL=https://ai.plivo.com/v1/trigger/your_india_trigger_id

# Plivo Regional Configuration - US (+1 / Other)
# Create account/org in Plivo Console with Data Region: US
PLIVO_US_AUTH_ID=your_us_plivo_auth_id
PLIVO_US_AUTH_TOKEN=your_us_plivo_auth_token
PLIVO_US_CALLER_NUMBER=+18005550199
PLIVO_US_AGENT_TRIGGER_URL=https://ai.plivo.com/v1/trigger/your_us_trigger_id

# Webhook Security Secret
PLIVO_WEBHOOK_SECRET=your_plivo_webhook_secret_key

# LLM Configuration (OpenAI for post-call qualification evaluation)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
