datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_AGENT
}

enum LeadStatus {
  NEW
  QUEUED
  CALLING
  CONNECTED
  QUALIFYING
  QUALIFIED
  NOT_QUALIFIED
  CALLBACK_REQUESTED
  CALLBACK_SCHEDULED
  COMPLETED
  NO_ANSWER
  FAILED
  DO_NOT_CALL
}

enum CallStatus {
  QUEUED
  INITIATING
  RINGING
  ANSWERED
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELED
}

enum QualificationDisposition {
  QUALIFIED
  NOT_QUALIFIED
  CALLBACK
  NOT_INTERESTED
  DO_NOT_CALL
  UNREACHABLE
}

enum CallbackStatus {
  SCHEDULED
  PROCESSING
  COMPLETED
  CANCELED
  FAILED
}

enum MessageRole {
  AI
  HUMAN
  SYSTEM
  TOOL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Campaign {
  id                  String       @id @default(uuid())
  name                String
  description         String?
  agentId             String?
  agent               AgentConfig? @relation(fields: [agentId], references: [id])
  status              String       @default("ACTIVE")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  leads               Lead[]
  callAttempts        CallAttempt[]
}

model AgentConfig {
  id                    String     @id @default(uuid())
  name                  String     @default("Default Qualification Rep")
  companyName           String     @default("Vedron Dev Co")
  voiceId               String     @default("21m00Tcm4TlvDq8ikWAM") // Default ElevenLabs voice Rachel
  language              String     @default("en-US")
  systemPrompt          String     @db.Text
  openingMessage        String
  closingMessage        String
  qualificationQuestions Json       // Array of questions [{ id, question, dimension, required }]
  scoringRules          Json       // Scoring weights e.g. { need: 25, budget: 25, authority: 20, timeline: 20, fit: 10 }
  qualificationThreshold Int       @default(60)
  maxCallDuration       Int        @default(600) // seconds
  maxAttempts           Int        @default(3)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  campaigns             Campaign[]
  callAttempts          CallAttempt[]
}

model Lead {
  id                 String               @id @default(uuid())
  firstName          String
  lastName           String?
  phone              String               @unique
  email              String?
  company            String?
  source             String               @default("website")
  status             LeadStatus           @default(NEW)
  qualificationScore Int                  @default(0)
  metadata           Json?
  campaignId         String?
  campaign           Campaign?            @relation(fields: [campaignId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  callAttempts       CallAttempt[]
  callbacks          Callback[]
  qualificationResult QualificationResult?

  @@index([status])
  @@index([phone])
}

model CallAttempt {
  id                  String               @id @default(uuid())
  leadId              String
  lead                Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId          String?
  campaign            Campaign?            @relation(fields: [campaignId], references: [id])
  agentId             String?
  agent               AgentConfig?         @relation(fields: [agentId], references: [id])
  attemptNumber       Int                  @default(1)
  twilioCallSid       String?              @unique
  elevenLabsSessionId String?              @unique
  elevenLabsMetadata  Json?
  status              CallStatus           @default(QUEUED)
  reason              String?              @default("new_lead")
  startedAt           DateTime?
  answeredAt          DateTime?
  endedAt             DateTime?
  duration            Int?                 // in seconds
  failureReason       String?
  summary             String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  messages            ConversationMessage[]
  qualificationResult QualificationResult?
  callbacks           Callback[]

  @@index([leadId])
  @@index([twilioCallSid])
  @@index([status])
}

model ConversationMessage {
  id            String      @id @default(uuid())
  callAttemptId String
  callAttempt   CallAttempt @relation(fields: [callAttemptId], references: [id], onDelete: Cascade)
  role          MessageRole
  content       String      @db.Text
  timestamp     DateTime    @default(now())
  metadata      Json?

  @@index([callAttemptId])
}

model QualificationResult {
  id            String                   @id @default(uuid())
  leadId        String                   @unique
  lead          Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  callAttemptId String                   @unique
  callAttempt   CallAttempt              @relation(fields: [callAttemptId], references: [id], onDelete: Cascade)
  result        QualificationDisposition @default(NOT_QUALIFIED)
  score         Int                      @default(0)
  budget        String?
  need          String?
  authority     String?
  timeline      String?
  summary       String?                  @db.Text
  rawOutput     Json?
  createdAt     DateTime                 @default(now())
}

model Callback {
  id            String         @id @default(uuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  callAttemptId String?
  callAttempt   CallAttempt?   @relation(fields: [callAttemptId], references: [id], onDelete: SetNull)
  scheduledFor  DateTime
  timezone      String         @default("Asia/Kolkata")
  reason        String?
  status        CallbackStatus @default(SCHEDULED)
  executedAt    DateTime?
  canceledAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([leadId])
  @@index([scheduledFor])
  @@index([status])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String   // "twilio" | "elevenlabs"
  eventId     String   @unique
  eventType   String
  payload     Json
  processed   Boolean  @default(false)
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([provider, eventId])
}
